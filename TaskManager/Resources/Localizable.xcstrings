      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto erstellen"
          }
        }
      }
    },
    "Don't have an account?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Konto?"
          }
        }
      }
    },
