{
  "sourceLanguage": "en",
  "strings": {
    "Add Task": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabe hinzufügen"
          }
        }
      }
    },
    "An account with this email already exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese E-Mail-Adresse gibt es bereits ein Konto."
          }
        }
      }
    },
    "At least 8 characters, with a letter and a number.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 8 Zeichen, mit einem Buchstaben und einer Zahl."
          }
        }
      }
    },
    "Changes will sync later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden später synchronisiert."
          }
        }
      }
    },
    "Choose a stronger password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein sichereres Passwort."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
