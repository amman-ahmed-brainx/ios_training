      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwort ausblenden"
          }
        }
      }
    },
    "If an account exists for %@, a reset link is on its way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls ein Konto für %@ existiert, ist ein Link zum Zurücksetzen unterwegs."
          }
        }
      }
    },
    "Include at least one letter and one number.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende mindestens einen Buchstaben und eine Zahl."
          }
        }
      }
    },
