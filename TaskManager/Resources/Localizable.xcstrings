      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail"
          }
        }
      }
    },
    "Enter a valid email address, like name@example.com.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine gültige E-Mail-Adresse ein, z. B. name@example.com."
          }
        }
      }
    },
    "Floating control": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwebendes Bedienelement"
          }
        }
      }
    },
    "For your security, please log in again to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zu deiner Sicherheit erneut an, um fortzufahren."
          }
        }
      }
    },
    "Forgot Password": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwort vergessen"
          }
        }
      }
    },
