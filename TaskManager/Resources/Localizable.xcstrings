            "value": "Registrieren"
          }
        }
      }
    },
    "Sign-in is unavailable because the app isn't connected to a server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist nicht verfügbar, weil die App mit keinem Server verbunden ist."
          }
        }
      }
    },
    "Signed In": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet"
          }
        }
      }
    },
    "Something went wrong. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es erneut."
          }
        }
      }
    },
    "Tap + to add your first task.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf +, um deine erste Aufgabe hinzuzufügen."
          }
        }
      }
    },
    "That email address doesn't look right.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse scheint nicht zu stimmen."
          }
        }
      }
    },
    "This account has been disabled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wurde deaktiviert."
          }
        }
      }
    },
    "This field is required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Feld ist erforderlich."
          }
        }
      }
    },
    "Too many attempts. Wait a moment and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Warte einen Moment und versuche es erneut."
          }
        }
      }
    },
    "Use at least %lld characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende mindestens %lld Zeichen."
          }
        }
      }
    },
    "We'll email you a link to choose a new password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden dir einen Link, mit dem du ein neues Passwort wählen kannst."
          }
        }
      }
    },
    "Welcome Back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück"
          }
        }
      }
    },
    "You appear to be offline. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du scheinst offline zu sein. Prüfe deine Verbindung und versuche es erneut."
          }
        }
      }
    },
    "You're Offline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline"
          }
        }
      }
    },
    "You're not signed in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht angemeldet."
          }
        }
      }
    },
    "Your session has expired. Please log in again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Bitte melde dich erneut an."
          }
        }
      }
    },
    "Your tasks will appear here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen deine Aufgaben."
